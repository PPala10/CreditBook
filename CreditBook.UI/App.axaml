<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CreditBook.UI.App"
             xmlns:local="using:CreditBook.UI"
             Name="CreditBook" RequestedThemeVariant="Light">
  <Application.DataTemplates><local:ViewLocator/></Application.DataTemplates>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes><ColorPaletteResources x:Key="Light" Accent="#3867E8"/></FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://CreditBook.UI/Styles/LightTheme.axaml"/>
  </Application.Styles>
</Application>
